# Portal de um conselho profissional, nao API publica: seja respeitoso.
CRAWLER_DELAY_SEGUNDOS=2

# Palavras-chave, aplicadas localmente (o portal ignora busca por URL). Decidem
# quais PDFs o sync padrao baixa, pela ementa, e o filtro do monitoramento, pela
# ementa e pelo texto.
PALAVRAS_CHAVE=inteligência artificial,telemedicina,prontuário eletrônico,algoritmo

DUCKDB_PATH=./data/cfm.duckdb

LOG_LEVEL=INFO

# --- Modo connector (servidor HTTP). Deixe em stdio para uso local. ---
TRANSPORTE=stdio
HTTP_HOST=127.0.0.1
HTTP_PORTA=8000
HTTP_PATH=/mcp
HTTP_STATELESS=true
# O teto global e o que protege a maquina: o trafego do Claude chega dos IPs da
# Anthropic, entao limitar so por IP juntaria todos os usuarios num balde so.
HTTP_LIMITE_GLOBAL_POR_MINUTO=1200
HTTP_LIMITE_POR_MINUTO=600

# Nomes publicos pelos quais o servidor aceita ser chamado, separados por
# virgula. Vazio = so loopback. Atras de um proxy ou tunel o cabecalho Host que
# chega e o nome publico, e sem ele aqui o SDK responde 421 (Invalid Host) a
# toda requisicao de fora, por protecao contra DNS rebinding.
HTTP_HOSTS_PUBLICOS=
