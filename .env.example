# Portal de um conselho profissional, nao API publica: seja respeitoso.
CRAWLER_DELAY_SEGUNDOS=2

# Filtro aplicado localmente sobre a ementa (o portal ignora busca por URL).
PALAVRAS_CHAVE=inteligência artificial,telemedicina,prontuário eletrônico,algoritmo

DUCKDB_PATH=./data/cfm.duckdb

# Horario fixo (HH:MM) em vez de intervalo relativo. Um LLM local costuma
# atender uma chamada por vez, entao vale rodar o sync de madrugada e, se voce
# tiver mais de um projeto assim, escalonar os horarios entre eles.
SYNC_HORA_LOCAL=02:00

LOG_LEVEL=INFO

# --- Modo connector (servidor HTTP). Deixe em stdio para uso local. ---
TRANSPORTE=stdio
HTTP_HOST=127.0.0.1
HTTP_PORTA=8000
HTTP_PATH=/mcp
HTTP_STATELESS=true
# O teto global e o que protege a maquina: o trafego do Claude chega dos IPs da
# Anthropic, entao limitar so por IP juntaria todos os usuarios num balde so.
HTTP_LIMITE_GLOBAL_POR_MINUTO=1200
HTTP_LIMITE_POR_MINUTO=600
